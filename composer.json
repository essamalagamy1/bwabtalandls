{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "laravel/livewire-starter-kit",
    "type": "project",
    "description": "The official Laravel starter kit for Livewire.",
    "keywords": [
        "laravel",
        "framework"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.3 | ^8.4",
        "barryvdh/laravel-debugbar": "*",
        "bensampo/laravel-enum": "*",
        "beyondcode/laravel-query-detector": "*",
        "blade-ui-kit/blade-icons": "^1.8",
        "carlos-meneses/laravel-mpdf": "^2.1",
        "codeat3/blade-radix-icons": "^1.8",
        "itsgoingd/clockwork": "^5.3",
        "laravel-notification-channels/webpush": "^12.1",
        "laravel/breeze": "*",
        "laravel/framework": "^13.0",
        "laravel/pulse": "^1.4",
        "laravel/sanctum": "*",
        "laravel/tinker": "*",
        "laravolt/avatar": "*",
        "livewire/livewire": "^4.0",
        "maatwebsite/excel": "^4.0",
        "mallardduck/blade-lucide-icons": "^1.23",
        "opcodesio/log-viewer": "^3.17",
        "outhebox/blade-flags": "*",
        "owenvoke/blade-fontawesome": "*",
        "php-flasher/flasher-laravel": "^2.1",
        "php-flasher/flasher-sweetalert-laravel": "^2.1",
        "php-flasher/flasher-toastr-laravel": "^2.1",
        "realrashid/sweet-alert": "^7.3",
        "robsontenorio/mary": "^2.3",
        "spatie/laravel-error-solutions": "^1.0",
        "spatie/laravel-medialibrary": "^11.17",
        "spatie/laravel-permission": "^6.24",
        "spatie/laravel-translatable": "^6.12"
    },
    "require-dev": {
        "barryvdh/laravel-ide-helper": "*",
        "fakerphp/faker": "^1.23",
        "larastan/larastan": "^3.0",
        "laravel/pail": "*",
        "laravel/pint": "*",
        "laravel/sail": "*",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.6",
        "pestphp/pest": "*",
        "pestphp/pest-plugin-laravel": "*"
    },
    "autoload": {
        "files": [
            "app/Helpers/helpers.php",
            "app/Helpers/CacheHelpers.php"
        ],
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
            "@php artisan migrate --graceful --ansi"
        ],
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "npx concurrently -c \"#93c5fd,#c4b5fd,#fb7185,#fdba74\" \"php artisan serve\" \"php artisan queue:listen --tries=1\" \"php artisan pail --timeout=0\" \"npm run dev\" --names=server,queue,logs,vite"
        ],
        "test": [
            "@php artisan config:clear --ansi",
            "@php artisan test"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
